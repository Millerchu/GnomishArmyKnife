TZ=Asia/Shanghai

IMAGE_TAG=1.0.0

WEB_PORT=18088
APP_BIND=127.0.0.1
APP_PORT=18081
JAVA_OPTS=-Xms256m -Xmx768m

# NAS SSO uses the NAS host only for identity verification and never persists its token.
GAK_NAS_SSO_ENABLED=true
GAK_NAS_BASE_URL=http://host.docker.internal:9999
GAK_NAS_SSO_SESSION_TTL=PT15M
GAK_NAS_SSO_CODE_TTL=PT30S

POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=25432
POSTGRES_DB=mydb
POSTGRES_USER=gak
POSTGRES_PASSWORD=change_me_strong_password

# Set to 'never' if you do not want schema.sql to run every startup.
SPRING_SQL_INIT_MODE=always

# Reserved for the optional redis compose profile.
ENABLE_REDIS=false
REDIS_PASSWORD=change_me_redis_password
