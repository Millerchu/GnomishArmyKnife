TZ=Asia/Shanghai

IMAGE_TAG=1.0.0

WEB_PORT=18080
APP_BIND=127.0.0.1
APP_PORT=18081
JAVA_OPTS=-Xms256m -Xmx768m

POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=25432
POSTGRES_DB=mydb
POSTGRES_USER=gak
POSTGRES_PASSWORD=change_me_strong_password

# Set to 'never' if you do not want schema.sql to run every startup.
SPRING_SQL_INIT_MODE=always

# 聚合数据“今日国内油价”接口（https://www.juhe.cn/docs/api/id/540）。
GAK_FUEL_PRICE_JUHE_API_KEY=
GAK_FUEL_PRICE_CACHE_MINUTES=30

# Reserved for the optional redis compose profile.
ENABLE_REDIS=false
REDIS_PASSWORD=change_me_redis_password
