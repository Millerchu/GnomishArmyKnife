<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- 继承你自己的 parent -->
    <parent>
        <groupId>com.gak</groupId>
        <artifactId>gak-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>gak-start</artifactId>
    <packaging>jar</packaging>

    <name>gak-start</name>
    <description>GAK 启动模块</description>

    <dependencies>
        <dependency>
            <groupId>com.gak</groupId>
            <artifactId>gak-framework</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.gak</groupId>
            <artifactId>gak-user</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gak</groupId>
            <artifactId>gak-worklog</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gak</groupId>
            <artifactId>gak-password-memo</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gak</groupId>
            <artifactId>gak-wow-character</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gak</groupId>
            <artifactId>gak-todo-list</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gak</groupId>
            <artifactId>gak-permission-management</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gak</groupId>
            <artifactId>gak-data-dictionary</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gak</groupId>
            <artifactId>gak-data-migration</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gak</groupId>
            <artifactId>gak-fuel-stats</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gak</groupId>
            <artifactId>gak-personal-bills</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Web 项目一般直接用 web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 只声明，不写版本（从 parent 继承） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
